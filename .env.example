SQLSERVER_DSN=sqlserver://user:password@host:1433?database=dbname
SERVER_PORT=8080
# IP con el que la API se anuncia (swagger/log). Si se deja vacío, se
# detecta automáticamente el IP de la máquina. Se escucha en todas las
# interfaces, por lo que cualquier equipo de la red puede consumir la API.
SERVER_HOST=
# Origenes permitidos para CORS (separados por coma). El frontend actual es
# React/Vite (http://localhost:5173); el 4200 es el de Angular legacy.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# RENIEC (servicio SOAP externo)
RENIEC_APP=HNSEB
RENIEC_USUARIO=44602631
RENIEC_CLAVE=
RENIEC_URL=https://wsvmin.minsa.gob.pe/wsreniecmq/serviciomq.asmx
RENIEC_TIMEOUT=30s

# SIS (servicio SOAP externo de afiliados)
SIS_USUARIO=HNAL
SIS_CLAVE=
SIS_URL=http://app.sis.gob.pe/sisWSAFI/Service.asmx
SIS_DNI_AUTORIZADO=
SIS_TIMEOUT=30s

# Firma Perú (Firmador Web) — requerido para /firmaperu/*
FIRMAPERU_TOKEN_URL=https://apps.firmaperu.gob.pe/admin/api/security/generate-token
FIRMAPERU_CLIENT_ID=
FIRMAPERU_CLIENT_SECRET=
# URL pública con la que el PC del firmante alcanza esta API (documentToSign/
# uploadDocumentSigned). Vacío => usa el Host del request.
FIRMAPERU_PUBLIC_URL=
FIRMAPERU_TIMEOUT=60s
# Directorio donde se guardan los PDF firmados (FIRMAPERU_SIGNED_DIR),
# p. ej. la carpeta dctos_firmados del frontend.
FIRMAPERU_SIGNED_DIR=C:\galenhospro\galenhos_frontend\dctos_firmados
# Ejecutable de 7-Zip (firma por lote).
SEVENZIP_PATH=C:\Program Files\7-Zip\7z.exe

# MINSA REFCON (servicio REST externo consultaReferenciaDetalle y listadoUps)
MINSA_REFCON_URL=https://servicios.minsa.gob.pe/mcs-servicios-refcon/servicio/v1.0.0/consultaReferenciaDetalle
# Endpoint del servicio que lista las UPS de un establecimiento
MINSA_REFCON_UPS_URL=https://servicios.minsa.gob.pe/mcs-servicios-refcon/servicio/v1.0.0/listadoUps
MINSA_REFCON_ESPECIALIDADES_URL=https://servicios.minsa.gob.pe/mcs-referencia-interoperabilidad/refcon-interoperabilidad/v1.0/listadoEspecialidades
# Endpoint del servicio que registra (envía) una referencia
MINSA_REFCON_SAVE_URL=https://servicios.minsa.gob.pe/mcs-servicios-refcon/servicio/v1.0.0/saveReferencia
# Credenciales institucionales que van en el header de la petición.
# Si el password contiene "$", enciérralo en comillas simples: PASSWORD='abc$12'.
MINSA_REFCON_USERNAME=
MINSA_REFCON_PASSWORD=
MINSA_REFCON_IPCLIENT=
# Valores por defecto de la petición (override por query param)
MINSA_REFCON_ESTABLECIMIENTO=7634
MINSA_REFCON_LIMITE=11
MINSA_REFCON_TIMEOUT=30s

# REFCON Reports (portal refcon.minsa.gob.pe) — genera/descarga la hoja de
# referencia oficial en PDF (/api/v1/refcon/hoja-referencia). Credenciales web
# institucionales del portal. Si el password contiene "$", usa comillas simples.
REFCON_REPORTS_URL=https://refcon.minsa.gob.pe/refconv02
REFCON_REPORTS_USERWEB=
REFCON_REPORTS_PASSWORDWEB=
REFCON_REPORTS_TIMEOUT=30s

# Almacenamiento remoto de PDFs firmados (servidor privado / IIS).
# Protocolo: sftp (SSH, puerto 22) o ftp (FTP/FTPS, puerto 21).
# Si SFTP_HOST o SFTP_USER están vacíos, el cliente queda deshabilitado (noop).
SFTP_PROTOCOL=sftp
# Solo protocol=ftp. explicit = AUTH TLS (WinSCP "TLS/SSL explícito"); plain | implicit.
SFTP_FTP_TLS=explicit
SFTP_HOST=
# Puerto por defecto según protocolo (22 sftp / 21 ftp) si se omite.
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_TIMEOUT=30s
# SFTP/SSH host key y/o verificación de cert FTPS. En red privada suele usarse true.
SFTP_INSECURE_IGNORE_HOST_KEY=true
SFTP_KNOWN_HOSTS=
# Prefijo remoto + patrones ({id}, {uuid}, {ext}).
SFTP_BASE_PATH=/ftp
SFTP_PATTERN_PRIMERA_ATENCION=primera-atencion/{id}/{uuid}.pdf
SFTP_PATTERN_EVOLUCION=evoluciones/{id}/{uuid}.pdf
